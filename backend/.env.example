# Copy this file to backend/.env and set secrets locally.
# Never commit backend/.env or paste credentials into chat.
# Secret values are stored under PREEMPTION_* names when configured in the app.

# PREEMPTION_OPENROUTER_API_KEY=
# PREEMPTION_ANTHROPIC_API_KEY=
# PREEMPTION_OPENAI_API_KEY=
# PREEMPTION_XAI_API_KEY=
# PREEMPTION_CODEX_API_KEY=
# PREEMPTION_GROQ_API_KEY=
# PREEMPTION_GEMINI_API_KEY=
# PREEMPTION_DEAPI_API_KEY=
# PREEMPTION_MISTRAL_API_KEY=
# PREEMPTION_HUGGINGFACE_API_KEY=
# PREEMPTION_DEEPINFRA_API_KEY=
# PREEMPTION_NVIDIA_API_KEY=
# PREEMPTION_TOGETHER_API_KEY=
# PREEMPTION_WEB_SEARCH_API_KEY=

# Gmail connection values are saved after SMTP/IMAP verification in Resources.
# Gmail SMTP submission: port 587 uses STARTTLS; port 465 uses implicit TLS.
# Personal Gmail limits total outgoing mail (commonly 500/day); Workspace quotas vary by plan.
# A 4.7.28 temporary rate limit requires pausing at least 10 minutes; a client-side delay
# does not increase the account's sending quota.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SENDER_ADDRESS=
# EMAIL_APP_PASSWORD=
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
